{
  "name": "creatureator",
  "version": "0.1.0",
  "private": true,
  "description": "Build custom Pathfinder 2e creatures in Foundry VTT by rescaling a bestiary chassis and grafting abilities.",
  "type": "module",
  "scripts": {
    "fetch:tables": "node tools/fetch-creature-tables.mjs",
    "fetch:corpus": "node tools/fetch-validation-corpus.mjs",
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
